        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte la consigne d’un degré pendant deux heures"
          }
        }
      }
    },
    "Temperatura actual y objetivo de una casa. Se pone naranja si la caldera está encendida.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current and target temperature of a home. Turns orange when the boiler is running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperatura actual y objetivo de una casa. Se pone naranja si la caldera está encendida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Température actuelle et consigne d’une maison. Devient orange quand la chaudière fonctionne."
          }
        }
      }
    },
