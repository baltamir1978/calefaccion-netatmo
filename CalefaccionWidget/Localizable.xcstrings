    "Sube el objetivo 1 °C durante 2 horas en la casa elegida.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raises the target 1 °C for 2 hours in the chosen home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube el objetivo 1 °C durante 2 horas en la casa elegida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte la consigne de 1 °C pendant 2 heures dans la maison choisie."
          }
        }
      }
    },
    "Sube el objetivo 1 °C por encima de la temperatura actual durante 2 horas.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raises the target 1 °C above the current temperature for 2 hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube el objetivo 1 °C por encima de la temperatura actual durante 2 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte la consigne de 1 °C au-dessus de la température actuelle pendant 2 heures."
          }
        }
      }
    },
    "Sube el objetivo un grado durante dos horas": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raises the target one degree for two hours"
          }
        },
        "es": {
