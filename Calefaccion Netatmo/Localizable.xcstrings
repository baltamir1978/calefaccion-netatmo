    "Cada barra son las 24 h de un día, con marcas cada 6 h. Toca un día para ver sus franjas.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each bar is one full day, with marks every 6 hours. Tap a day to see its periods."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada barra son las 24 h de un día, con marcas cada 6 h. Toca un día para ver sus franjas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque barre représente 24 h, avec des repères toutes les 6 heures. Touchez un jour pour voir ses plages."
          }
        }
      }
    },
