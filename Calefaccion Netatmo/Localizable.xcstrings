    "Cambia la temperatura de cada franja del horario «%@». Las horas no se modifican.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the temperature of each period of the “%@” schedule. The times stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la temperatura de cada franja del horario «%@». Las horas no se modifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez la température de chaque plage du programme « %@ ». Les horaires ne changent pas."
          }
        }
      }
    },
